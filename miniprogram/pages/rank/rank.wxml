<view class="container">
  <view class="title">🏆 排行榜</view>

  <view class="card" wx:if="{{rankList.length === 0 && !loading}}">
    <view class="empty">暂无记录，快去穿越赚钱吧！</view>
  </view>

  <view class="card" wx:if="{{loading}}">
    <view class="empty">加载中...</view>
  </view>

  <view class="rank-list">
    <view wx:for="{{rankList}}" wx:key="index" class="rank-item">
      <view class="rank-num {{index < 3 ? 'top-rank' : ''}}">
        <text wx:if="{{index === 0}}">🥇</text>
        <text wx:elif="{{index === 1}}">🥈</text>
        <text wx:elif="{{index === 2}}">🥉</text>
        <text wx:else>{{index + 1}}</text>
      </view>
      <view class="rank-info">
        <text class="rank-user">{{item.user_name || '匿名玩家'}}</text>
        <text class="rank-date">{{item.start_date}} ({{item.duration === '1month' ? '1个月' : item.duration === '3month' ? '3个月' : '1年'}})</text>
      </view>
      <view class="rank-profit {{item.profit_rate >= 0 ? 'profit' : 'loss'}}">
        {{item.profit_rate >= 0 ? '+' : ''}}{{item.profit_rate}}%
      </view>
    </view>
  </view>

  <view class="action-area">
    <t-button theme="primary" block bindtap="goHome">开始挑战</t-button>
  </view>
</view>
