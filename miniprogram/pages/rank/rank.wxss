.container {
  padding: 30rpx;
  min-height: 100vh;
  background: #f5f5f5;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  text-align: center;
  color: #1a1a2e;
  margin: 40rpx 0;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.rank-list {
  margin-top: 20rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 24rpx 30rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.rank-num {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  font-size: 28rpx;
}

.rank-num.top-rank {
  background: transparent;
  font-size: 40rpx;
}

.rank-info {
  flex: 1;
  margin-left: 20rpx;
}

.rank-user {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
}

.rank-date {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

.rank-profit {
  font-size: 32rpx;
  font-weight: bold;
}

.profit { color: #e74c3c; }
.loss { color: #27ae60; }

.empty {
  text-align: center;
  color: #999;
  padding: 60rpx;
  font-size: 28rpx;
}

.action-area {
  margin-top: 40rpx;
}
