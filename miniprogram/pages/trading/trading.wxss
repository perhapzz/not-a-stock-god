.container {
  padding: 20rpx;
  min-height: 100vh;
  background: #f5f5f5;
}

.header {
  background: linear-gradient(135deg, #1a1a2e, #16213e);
  color: #fff;
  padding: 24rpx 30rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.date-display {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.assets-row {
  display: flex;
  justify-content: space-between;
}

.asset-item {
  text-align: center;
}

.asset-label {
  display: block;
  font-size: 22rpx;
  color: #aaa;
}

.asset-value {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  margin-top: 6rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  color: #333;
}

.profit { color: #e74c3c; }
.loss { color: #27ae60; }

.kline-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.stock-name {
  font-size: 32rpx;
  font-weight: bold;
}

.change-pct {
  font-size: 28rpx;
  font-weight: bold;
}

.price-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  gap: 12rpx;
  font-size: 24rpx;
}

.price-item {
  text-align: center;
}

.price-item .label {
  display: block;
  color: #999;
  font-size: 22rpx;
}

.volume-info {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #666;
}

.stock-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.stock-item.selected {
  background: #e8f4fd;
}

.stock-name-text {
  font-size: 26rpx;
}

.stock-code {
  font-size: 24rpx;
  color: #999;
}

.quick-amounts {
  display: flex;
  gap: 16rpx;
  margin: 16rpx 0;
}

.trade-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}

.position-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.pos-left { flex: 1; }
.pos-name { display: block; font-size: 26rpx; font-weight: bold; }
.pos-detail { display: block; font-size: 22rpx; color: #999; margin-top: 4rpx; }
.pos-right { text-align: right; }
.pos-value { display: block; font-size: 26rpx; }

.empty-tip {
  text-align: center;
  color: #999;
  padding: 30rpx;
  font-size: 26rpx;
}

.action-area {
  margin-top: 20rpx;
}

.secondary-actions {
  display: flex;
  justify-content: space-around;
  margin-top: 20rpx;
}

.trade-history-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.trade-history-panel {
  background: #fff;
  width: 100%;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx;
  max-height: 70vh;
}

.trade-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 24rpx;
}

.trade-buy { color: #e74c3c; font-weight: bold; }
.trade-sell { color: #27ae60; font-weight: bold; }
.trade-date { color: #999; font-size: 22rpx; }
