.header {
  background: #1a1a2e;
  color: #fff;
  padding: 20rpx 30rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.date-display {
  font-size: 32rpx;
  font-weight: bold;
}

.cash-info {
  font-size: 24rpx;
  margin-top: 10rpx;
  color: #ccc;
}

.kline-info .stock-name {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.price-row {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
}

.stock-item {
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #eee;
  font-size: 26rpx;
}

.stock-item.selected {
  background: #e8f4fd;
  color: #1677ff;
}

.trade-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.position-item {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.action-area {
  margin-top: 30rpx;
}
