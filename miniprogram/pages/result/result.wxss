.result-card {
  text-align: center;
}

.result-label {
  font-size: 28rpx;
  color: #666;
}

.result-value {
  font-size: 56rpx;
  font-weight: bold;
  color: #1a1a2e;
  margin: 20rpx 0;
}

.result-row {
  display: flex;
  justify-content: space-around;
  margin: 30rpx 0;
}

.result-item .label {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.result-item .value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  margin-top: 10rpx;
}

.rank-display {
  font-size: 32rpx;
  color: #f39c12;
  font-weight: bold;
  margin-top: 20rpx;
}

.action-area {
  margin-top: 60rpx;
}
