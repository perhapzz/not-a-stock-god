page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.container {
  padding: 20rpx 30rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #1a1a2e;
  text-align: center;
  margin: 40rpx 0;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  margin-bottom: 40rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}

.disclaimer {
  font-size: 22rpx;
  color: #999;
  text-align: center;
  padding: 30rpx;
}

.profit {
  color: #e74c3c;
}

.loss {
  color: #27ae60;
}
